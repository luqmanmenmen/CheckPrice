generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id                Int      @id @default(autoincrement())
  sku               String   @unique
  barcode           String?  @unique
  article           String?
  description       String
  acara             String?
  fromDate          String?
  toDate            String?
  hargaNormal       Float    @default(0)
  hargaNormalSource String? // "PROMO" | "PQ_STOCK" | "MANUAL" — PQ tidak boleh menimpa harga dari PROMO
  hargaPromo        Float?
  diskon            String?
  discountType      String?
  promoFileName     String?
  brand             String?
  dept              String?
  color             String?
  size              String?
  imageUrl          String? // URL foto model resmi produk dari CDN
  images            String   @default("[]") // JSON array string daftar foto varian (auto-parsed oleh prisma.ts $extends)
  lastPurchaseDate  String?
  stok              Int      @default(0) // EOH_UNIT — stok saat ini (unit)
  eoh_retail        Float    @default(0) // EOH_RETAIL — nilai stok saat ini (Rp)
  sales_mtd         Int      @default(0) // MTD_SALES_UNIT — terjual bulan ini (unit)
  sales_mtd_retail  Float    @default(0) // MTD_SALES_RETAIL — omzet bulan ini langsung dari POS (Rp)
  sales_wtd         Int      @default(0) // WTD_SALES_UNIT — terjual minggu ini (unit)
  sales_wtd_retail  Float    @default(0) // WTD_SALES_RETAIL — omzet minggu ini (Rp)
  sales_ytd         Int      @default(0) // YTD_SALES_UNIT — terjual tahun ini (unit)
  sales_ytd_retail  Float    @default(0) // YTD_SALES_RETAIL — omzet tahun ini (Rp) — sumber kebenaran tertinggi
  boy_unit          Int      @default(0) // BOY_UNIT — stok awal tahun (unit)
  boy_retail        Float    @default(0) // BOY_RETAIL — nilai stok awal tahun (Rp)
  bom_unit          Int      @default(0)
  day_sales_unit    Int      @default(0)
  day_sales_retail  Float    @default(0)
  poSuggestions     PoSuggestion[]
  dailySales        DailySales[]
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@index([article])
  @@index([stok(sort: Desc), sku(sort: Asc)])
  @@index([updatedAt(sort: Desc)])
  @@index([brand])
  @@index([dept])
  @@index([hargaPromo])
  @@index([toDate])
}

/// Tabel Katalog Pre-Grouped & Ternormalisasi yang dibangun oleh Python Engine (`build_catalog_index.py`)
model CatalogArticle {
  key               String   @id
  sku               String
  barcode           String?
  article           String?
  description       String
  brand             String?
  dept              String?
  brandGroup        String // "SUKO" | "MUKU" | "ZES"
  subBrand          String // Merk asli ter-normalisasi (bebas label divisi seperti CHILDREN BOYS)
  categoryKey       String // JAKET | ATASAN | CELANA | DRESS_ROK | SEPATU_SANDAL | TAS_AKSESORIS | BEAUTY | TIDUR_DALAM | OTHER
  color             String?
  size              String?
  stok              Int      @default(0)
  hargaNormal       Float    @default(0)
  hargaPromo        Float?
  diskon            String?
  discountType      String?
  acara             String?
  toDate            String?
  imageUrl          String?
  articleGroupCount Int      @default(1)
  articleTotalStok  Int      @default(0)
  articleColors     String   @default("[]") // JSON array string (auto-parsed oleh prisma.ts $extends)
  articleSizes      String   @default("[]") // JSON array string (auto-parsed oleh prisma.ts $extends)
  articleHasPromo   Boolean  @default(false)
  articlePromoLabel String?
  sortRank          Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@index([article])
  @@index([sortRank])
  @@index([brandGroup, sortRank])
  @@index([brandGroup, categoryKey, sortRank])
  @@index([brandGroup, subBrand, sortRank])
  @@index([brandGroup, subBrand, categoryKey, sortRank])
}

/// Tabel alias multi-barcode per SKU agar 1 SKU bisa menyimpan banyak barcode (internal + vendor EAN/alfanumerik)
model BarcodeAlias {
  barcode     String   @id
  barcodeNorm String
  sku         String
  source      String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([sku])
  @@index([barcodeNorm])
}

model DailySales {
  id        String   @id @default(cuid())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  date      DateTime
  qtySold   Int
  omzet     Float    @default(0) // Omzet aktual dari POS (MTD_SALES_RETAIL delta harian)
  createdAt DateTime @default(now())

  @@unique([productId, date]) // Only one record per product per day
  @@index([date])
}

model User {
  id          String        @id @default(cuid())
  nik         String        @unique
  pin         String
  name        String
  role        String        @default("CREW_STORE") // "SUPERVISOR" | "CREW_STORE"
  status      String        @default("ACTIVE") // "ACTIVE" | "BREAK" | "OFFLINE"
  toko        String?
  redirectMds Boolean       @default(false)
  sessionId   String?
  lastLogin   DateTime?
  lastActive  DateTime?
  loginCount  Int           @default(0)
  loginLogs   LoginLog[]
  shifts      Shift[]
  tickets     Ticket[]
  syncHistory SyncHistory[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nik       String
  name      String
  role      String   @default("CREW_STORE") // "SUPERVISOR" | "CREW_STORE"
  shift     Int? // 1 or 2
  jobTitle  String? // Posisi yang dipilih saat login
  toko      String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Shift {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      Int // 1 or 2
  startTime DateTime  @default(now())
  endTime   DateTime?
  tickets   Ticket[]
}

model Ticket {
  id          String   @id @default(cuid())
  shiftId     String
  shift       Shift    @relation(fields: [shiftId], references: [id])
  requesterId String
  requester   User     @relation(fields: [requesterId], references: [id])

  type     String // "STOCK_CHECK" | "REQUEST" | "FACING_OUT"
  priority String @default("LOW") // "LOW" | "HIGH"
  status   String @default("PENDING") // "PENDING" | "READY" | "OOS" | "COMPLETED"

  sku      String
  size     String?
  qty      Int?
  photoUrl String? // URL to the physical price tag photo
  ocrData  String? // JSON string of OCR raw data

  reason String? // OOS reason from warehouse

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model PoSuggestion {
  id           String   @id @default(cuid())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
  suggestedQty Int
  reason       String
  status       String   @default("OPEN") // "OPEN" | "CLOSED"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model SyncHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // "PQ_HARIAN", "PROMO_MINGGUAN", "MDS_SALES_SYNC", etc.
  fileName  String
  fileUrl   String?
  status    String // "SUCCESS", "FAILED"
  records   Int
  createdAt DateTime @default(now())

  @@index([status, type, createdAt(sort: Desc)])
}

/// Penyimpanan berkas internal 100% di Turso Cloud (pengganti penuh Supabase Storage)
model StorageObject {
  path        String   @id
  contentType String   @default("application/octet-stream")
  sizeBytes   Int      @default(0)
  chunkCount  Int      @default(1)
  updatedAt   DateTime @default(now()) @updatedAt
}

model StorageChunk {
  path       String
  chunkIndex Int
  dataBase64 String

  @@id([path, chunkIndex])
  @@index([path])
}
