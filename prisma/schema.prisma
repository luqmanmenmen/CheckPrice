generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id            Int      @id @default(autoincrement())
  sku           String   @unique
  barcode       String?  @unique
  article       String?
  description   String
  acara         String?
  fromDate      String?
  toDate        String?
  hargaNormal   Float
  hargaPromo    Float?
  diskon        String?
  discountType  String?
  promoFileName String?
  brand         String?
  dept          String?
  stok          Int      @default(0)
  sales_mtd     Int      @default(0)
  sales_wtd     Int      @default(0)
  poSuggestions PoSuggestion[]
  dailySales    DailySales[]
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model DailySales {
  id        String   @id @default(cuid())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  date      DateTime
  qtySold   Int
  createdAt DateTime @default(now())

  @@unique([productId, date]) // Only one record per product per day
}

model User {
  id        String   @id @default(cuid())
  nik       String   @unique
  pin       String
  name      String
  role      Role     @default(SA)
  status    UserStatus @default(ACTIVE)
  toko      String?
  shifts    Shift[]
  tickets   Ticket[]
  syncHistory SyncHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserStatus {
  ACTIVE
  BREAK
}

enum Role {
  SA           // Cashier, Fitter, Entrance, Runner all grouped under SA (Sales Area) who can request
  WAREHOUSE    // Warehouse staff who fulfill requests
  SUPER_ADMIN  // Master control
}

model Shift {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      Int       // 1 or 2
  startTime DateTime  @default(now())
  endTime   DateTime?
  tickets   Ticket[]
}

model Ticket {
  id          String   @id @default(cuid())
  shiftId     String
  shift       Shift    @relation(fields: [shiftId], references: [id])
  requesterId String
  requester   User     @relation(fields: [requesterId], references: [id])
  
  type        TicketType
  priority    Priority @default(LOW)
  status      Status   @default(PENDING)
  
  sku         String
  size        String?
  qty         Int?
  photoUrl    String?  // URL to the physical price tag photo
  ocrData     String?  // JSON string of OCR raw data
  
  reason      String?  // OOS reason from warehouse
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TicketType {
  STOCK_CHECK // Tanya Stok
  REQUEST     // Request Barang
}

enum Priority {
  LOW
  HIGH
}

enum Status {
  PENDING
  READY
  OOS
  COMPLETED // When SA accepts the ready item
}

model PoSuggestion {
  id          String   @id @default(cuid())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  suggestedQty Int
  reason      String
  status      PoStatus @default(OPEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PoStatus {
  OPEN
  CLOSED
}

model SyncHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "PQ_HARIAN", "PROMO_MINGGUAN"
  fileName  String
  status    String   // "SUCCESS", "FAILED"
  records   Int
  createdAt DateTime @default(now())
}
