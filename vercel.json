{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "api/py_live.py": {
      "maxDuration": 30,
      "includeFiles": "python-engine/storehub_live_engine.py"
    },
    "api/py_wa_cs.py": {
      "maxDuration": 30,
      "includeFiles": "python-engine/{wa_cs_engine.py,storehub_live_engine.py,suko_product_knowledge.py,suko_auto_share.py}"
    }
  },
  "daemons": {
    "wa-cs-bridge": {
      "root": "wa-cs-bridge/",
      "entrypoint": "Dockerfile",
      "instances": {
        "sin1": 1
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      },
      "terminationGracePeriodSeconds": 30,
      "livenessProbe": {
        "httpGet": {
          "port": 7860,
          "path": "/health"
        },
        "initialDelaySeconds": 15,
        "periodSeconds": 30,
        "timeoutSeconds": 3,
        "failureThreshold": 3
      }
    }
  }
}
